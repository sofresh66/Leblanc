{
  "name": "leblanc-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "frontend",
    "worker",
    "shared",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@leblanc/frontend",
    "dev:deps": "npm run build --workspace=@leblanc/shared",
    "build": "npm run build --workspace=@leblanc/shared && npm run build --workspace=@leblanc/frontend",
    "typecheck": "npm run pretypecheck --workspace=@leblanc/worker && tsc --build --pretty && tsc --noEmit -p frontend && tsc --noEmit -p frontend/functions",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run build --workspace=@leblanc/shared && vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build --workspace=@leblanc/shared && vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run build --workspace=@leblanc/shared && npm run test:e2e --workspace=@leblanc/frontend",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:ingest:datatourisme": "node scripts/ingest-datatourisme.mjs",
    "predb:ingest:places": "npm run build --workspace=@leblanc/shared",
    "db:ingest:places": "node scripts/ingest-places.mjs",
    "predb:ingest:osm-places": "npm run build --workspace=@leblanc/shared",
    "db:ingest:osm-places": "node scripts/ingest-osm-places.mjs",
    "db:import:restaurants-manuel": "node scripts/import-restaurants-manuel.mjs",
    "db:ingest:openagenda": "node scripts/ingest-openagenda.mjs",
    "db:mocks": "node scripts/hide-mocks.mjs",
    "db:openagenda": "node scripts/hide-openagenda.mjs",
    "db:test": "node scripts/test-db.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@playwright/test": "1.56.1",
    "@types/node": "24.13.6",
    "@types/pg": "8.11.10",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "eslint": "9.37.0",
    "pg": "8.13.1",
    "prettier": "3.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vitest": "2.1.9",
    "wrangler": "4.138.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260921.1": true
  }
}
