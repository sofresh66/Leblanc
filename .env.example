# Database (Neon PostgreSQL)
# URL poolée pour le Worker Cloudflare (via pgbouncer)
DATABASE_URL=postgresql://user:pass@host-pooler/db?sslmode=require
# URL directe (sans pooler) pour les migrations et scripts
DATABASE_URL_DIRECT=postgresql://user:pass@host/db?sslmode=require
# URL de la branche de test (pour les tests d'intégration manuels)
# DATABASE_URL_TEST=postgresql://user:pass@host-test/db?sslmode=require

# External APIs
OPENAGENDA_API_KEY=
DATATOURISME_API_KEY=

# Frontend
VITE_API_URL=
# Force l'usage des mocks locaux au lieu de l'API Worker
VITE_USE_MOCK=false
